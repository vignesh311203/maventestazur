APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://app:change-me@db:5432/realestate
REDIS_URL=redis://redis:6379/0
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
# Optional private Google Sheets mirror. Never commit credentials.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional generative AI (opt-in questions only)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional private email reports over TLS (465 or 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
