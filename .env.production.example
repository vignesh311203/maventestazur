# Copy to .env.production (gitignored). Never commit real secrets.
# Use URL-safe random values, e.g. python -c "import secrets; print(secrets.token_hex(32))"
PUBLIC_DOMAIN=metroestate.example.com
POSTGRES_PASSWORD=replace-with-generated-hex-password
APP_SECRET_KEY=replace-with-generated-hex-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-first-run
